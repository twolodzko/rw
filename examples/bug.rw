
# infix <-> 10
# let $A <-> $B => ($A and $B) or ((not $A) and (not $B))

let $A and $B => $B and $A
let $A and true => $A
let $A and false => false

let $A or $B => $B or $A
let $A or false => $A
let $A or true => true

let not true => false
let not false => true

assert (false and true) or (((not false)) and false)

